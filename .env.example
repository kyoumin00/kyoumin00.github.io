# 환경변수 예시 (실제 값 아님 / 복사해서 .env로 쓰고 값 채우기)
# .env 파일은 커밋/배포 공개 출력에서 제외된다.
# 실제 비밀 키는 Vercel 환경변수 화면에만 입력하고, 이 파일에는 넣지 않는다.

# Supabase 프로젝트 URL (예: https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase secret 키 (서버 전용 비밀 키 — 서버 함수에서만 사용)
# 브라우저/공개 설정 이름(VITE_, NEXT_PUBLIC_ 등)에는 절대 넣지 않는다.
SUPABASE_SECRET_KEY=
